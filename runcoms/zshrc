export ROS2_WORKSPACE="${ROS2_WORKSPACE:-$HOME/ros2_ws}"

# Build from $ROS2_WORKSPACE regardless of the current directory, so that running
# colcon inside a package does not create build/install trees there.
#
# Inside a worktree that lives outside the workspace, this would build whatever
# the workspace currently points at rather than the code being edited, so require
# cbw instead.
#
# $ROS2_WORKSPACE is expanded at call time, so it may be set after this function
# is defined (e.g. in .zshrc_local) or overridden for a single invocation.
function colcon() {
    # No workspace configured means this layout is not in use here, so stay out
    # of the way and behave like plain colcon. (An empty value would also make the
    # cd below run with no argument and build in $HOME.)
    if [ -z "$ROS2_WORKSPACE" ]; then
        command colcon "$@"
        return
    fi
    if [[ "$PWD" != "$ROS2_WORKSPACE"* ]] && git rev-parse --show-toplevel >/dev/null 2>&1; then
        echo "colcon: inside a worktree; use cbw instead:" >&2
        echo "  cbw $*" >&2
        return 1
    fi
    echo "ROS2_WORKSPACE: ${ROS2_WORKSPACE}"
    # A subshell rather than pushd/popd. Under prezto's PUSHD_IGNORE_DUPS,
    # pushing $ROS2_WORKSPACE while already standing in it is discarded as a
    # duplicate, so the matching popd pops whatever came before and sends the
    # caller there instead of leaving them put. cd inside a subshell cannot move
    # the caller at all, and && keeps colcon from running in the current
    # directory when the workspace is missing.
    ( cd $ROS2_WORKSPACE && command colcon "$@" )
    local ret=$?
    # Missing before the first successful build, and after a failed one. Sourcing
    # it is a side errand, so its outcome must not stand in for colcon's: without
    # the saved status, a failed build reported success whenever the file happened
    # to be there, and a good one reported failure whenever it was not.
    [ -f $ROS2_WORKSPACE/install/setup.zsh ] && source $ROS2_WORKSPACE/install/setup.zsh
    return $ret
}

# Cache directory holding the build/install trees for the current worktree:
# ~/.cache/colcon/<repository>/<worktree>.
#
# Keyed by repository as well as worktree because worktree names are only unique
# within a repository: two repositories that both have a feature-x worktree would
# otherwise share one build directory. Nested instead of joined by a separator
# because both names routinely contain hyphens, so a flat key could not be split
# back apart; nesting also makes `rm -rf ~/.cache/colcon/<repository>` a
# per-repository cleanup.
function _cbw_out_dir() {
    local wt common repo
    wt=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
    # --git-common-dir resolves to the main repository even from a linked
    # worktree. --path-format=absolute is required: the bare form returns a path
    # relative to the cwd when called inside the main worktree.
    common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
    if [[ ${common:t} == .git ]]; then
        repo=${common:h:t}
    else
        # A bare clone has no .git directory to take the parent of.
        repo=${common:t:r}
    fi
    print -r -- $HOME/.cache/colcon/$repo/${wt:t}
}

# colcon build/test for the current git worktree.
#
# Points --base-paths at the worktree and keeps build/install out of tree (see
# _cbw_out_dir), so several worktrees can be built and tested in parallel without
# interfering with each other.
#
# Dependencies are resolved from the base workspace ($ROS2_WORKSPACE) used as an
# underlay, so only the target packages need to be rebuilt.
#
# Runs in a subshell so that the exported variables and the sourced underlay do
# not leak into the caller. RMW_IMPLEMENTATION in particular is switched for
# tests and must not stay behind and break talking to a real robot. As a result
# the built packages are NOT visible to the calling shell; run cbwa when they
# need to be (see below).
#
# Usage:
#   cbw build --packages-select <pkg>
#   cbw test  --packages-select <pkg>
#   cbw test-result --verbose
function cbw() {
    local wt out ws
    wt=$(git rev-parse --show-toplevel 2>/dev/null) || {
        echo "cbw: run inside a git worktree/repository" >&2
        return 1
    }
    out=$(_cbw_out_dir) || return 1
    ws=${ROS2_WORKSPACE:-$HOME/ros2_ws}
    echo "cbw: worktree=$wt"
    echo "cbw: out=$out"
    (
        [ -n "$ROS_DISTRO" ] && [ -f /opt/ros/$ROS_DISTRO/setup.zsh ] \
            && source /opt/ros/$ROS_DISTRO/setup.zsh
        # Underlay providing the dependencies that are not rebuilt here.
        [ -f $ws/install/setup.zsh ] && source $ws/install/setup.zsh
        # Reuse the repository build settings (build type, compiler launcher, ...).
        [ -f $wt/colcon_defaults.yaml ] \
            && export COLCON_DEFAULTS_FILE=$wt/colcon_defaults.yaml
        if command -v ccache >/dev/null 2>&1; then
            # Keep the build path out of the hash so the cache is shared across
            # worktrees; otherwise each new path misses the whole cache.
            export CCACHE_BASEDIR=$out
            export CCACHE_NOHASHDIR=1
        fi
        case $1 in
            test-result)
                # test-result takes neither --base-paths nor --install-base.
                command colcon "$@" --test-result-base $out/build
                ;;
            test)
                # The interactive RMW may be tuned for real robots rather than for
                # tests. Set CBW_TEST_RMW to the value the repository expects (see
                # its AGENTS.md); left unset, the current environment is used.
                if [ -n "$CBW_TEST_RMW" ]; then
                    export RMW_IMPLEMENTATION=$CBW_TEST_RMW
                    echo "cbw: RMW_IMPLEMENTATION=$RMW_IMPLEMENTATION"
                fi
                command colcon "$@" --base-paths $wt \
                    --build-base $out/build --install-base $out/install
                ;;
            *)
                command colcon "$@" --base-paths $wt \
                    --build-base $out/build --install-base $out/install
                ;;
        esac
    )
}

# Source the install space that cbw produced for the current worktree, so the
# packages built there can actually be run.
#
# Only needed to launch or run nodes locally; checking that a build or a test
# passes needs cbw alone. The worktree overlays the base workspace, so its
# packages win over the ones already installed there.
#
# Usage:
#   cbw build --packages-select <pkg>
#   cbwa
#   ros2 launch <pkg> <launch file>
function cbwa() {
    local out ws
    out=$(_cbw_out_dir) || {
        echo "cbwa: run inside a git worktree/repository" >&2
        return 1
    }
    ws=${ROS2_WORKSPACE:-$HOME/ros2_ws}
    if [ ! -f $out/install/setup.zsh ]; then
        echo "cbwa: $out/install not found; run 'cbw build' first" >&2
        return 1
    fi
    [ -n "$ROS_DISTRO" ] && [ -f /opt/ros/$ROS_DISTRO/setup.zsh ] \
        && source /opt/ros/$ROS_DISTRO/setup.zsh
    [ -f $ws/install/setup.zsh ] && source $ws/install/setup.zsh
    source $out/install/setup.zsh
    echo "cbwa: activated $out/install"
}

